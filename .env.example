# Required — Anthropic API key for Claude AI (game master)
ANTHROPIC_API_KEY=sk-ant-...

# Required for auth (better-auth) — base URL of the app
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Required — Administratior email address. Used to identify the admin
ADMIN_EMAIL=

# Required — 32-byte hex secret for encrypting user API keys at rest
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=

# Optional — Resend API key for transactional email (account approval, bonus turn notifications)
RESEND_API_KEY=re_...

# Optional — Jira API token for bug report submission via /api/bug-report
JIRA_API_TOKEN=...

# Optional — Cloudflare R2 public URL for adventure map images
# In local dev this is empty and assets resolve to public/
NEXT_PUBLIC_ASSETS_URL=https://images.example.com
